   "source": [
    "def lagrange(x, y, xp):\n",
    "    yp = 0\n",
    "\n",
    "    for i in range(len(x)):\n",
    "        p = y[i]\n",
    "\n",
    "        for j in range(len(x)):\n",
    "            if i != j:\n",
    "                p = p * (xp - x[j]) / (x[i] - x[j])\n",
    "\n",
    "        yp += p\n",
    "\n",
    "    return yp\n",
    "\n",
    "\n",
    "x = [0, 1, 2, 5]\n",
    "y = [2, 3, 12, 147]\n",
    "\n",
    "print(lagrange(x, y, 3))"
   ]
  }
